# AWS Credentials (read-only IAM user recommended)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# Google Gemini API (free tier — get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Database
DATABASE_URL=postgresql://cloudsense:cloudsense@localhost:5432/cloudsense

# Slack (optional — for daily digest alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
SLACK_ALERT_CHANNEL=#cloud-costs

# App settings
ENVIRONMENT=development
LOG_LEVEL=INFO
COST_ALERT_THRESHOLD=100   # Alert if daily spend exceeds this (USD)

# Frontend
VITE_API_URL=http://localhost:8000

# Observability — OpenTelemetry + Jaeger
OTLP_ENDPOINT=http://localhost:4317   # points to jaeger:4317 inside Docker
TRACING_ENABLED=true
